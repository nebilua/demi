    "build": "node scripts/build.js",
    "test:build-cleanup": "node scripts/test-build-cleanup.js",
    "test:build-port": "node scripts/test-build-port.js",
    "test:static-build": "node scripts/test-static-build.js",
    "test:release-cleanup": "node scripts/test-static-build.js --release-cleanup",
    "test:build-lock": "node scripts/test-static-build.js --build-lock",
    "test:feature-flows": "tsx scripts/test-feature-flows.js",
    "test:local-data-transfer": "tsx scripts/test-local-data-transfer.js",
    "test:component-failures": "tsx scripts/test-component-failures.js",
    "profile:runtime": "tsx scripts/profile-runtime.js",
    "test:voice-boundaries": "tsx scripts/test-voice-boundaries.js",
    "test:android-reminders": "tsx scripts/test-android-reminders.js",
    "test:android-release": "node scripts/test-android-release.js",
    "test:scheduled-jobs": "tsx scripts/test-scheduled-jobs.js",
    "test:privacy": "tsx scripts/test-privacy-capabilities.js",
    "test:cloud-fallback": "tsx scripts/test-cloud-fallback.js",
    "test:tool-registry": "tsx scripts/test-tool-registry.js",
    "test:sandbox-code": "tsx scripts/test-sandbox-code.js",
    "test:research": "tsx scripts/test-research.js",
    "verify:android-alpha": "node scripts/verify-android-alpha.js",
    "preflight:android-alpha": "ANDROID_PREFLIGHT_ONLY=1 node scripts/validate-android-apk.js",
    "validate:android-apk": "node scripts/validate-android-apk.js",
    "serve": "node server/serve.js",
    "test:build-failure": "node scripts/test-static-build.js --failure-check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
